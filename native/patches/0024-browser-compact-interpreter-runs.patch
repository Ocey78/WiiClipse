+#pragma once
+
+#include <array>
+#include <cstddef>
+
+#include "Common/CommonTypes.h"
+
+class Interpreter;
+union UGeckoInstruction;
+
+namespace BrowserInterpret
+{
+struct Op
+{
+  void (*handler)(Interpreter&, UGeckoInstruction);
+  u32 instruction;
+};
+
+struct Header
+{
+  Interpreter* interpreter = nullptr;
+  u32 count = 0;
+  u32 first_pc = 0;
+};
+
+struct Batch
+{
+  Header header;
+  std::array<Op, 32> ops;
+};
+static_assert(offsetof(Batch, ops) == sizeof(Header));
+
+constexpr std::size_t PayloadSize(u32 count)
+{
+  return sizeof(Header) + count * sizeof(Op);
+}
+}  // namespace BrowserInterpret
