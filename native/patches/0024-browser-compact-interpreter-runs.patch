+s32 CachedInterpreter::RunBrowserInterpretOps(PowerPC::PowerPCState& ppc_state,
+                                             const BrowserInterpret::Header& operands)
+{
+  const auto* ops = reinterpret_cast<const BrowserInterpret::Op*>(
+      reinterpret_cast<const u8*>(&operands) + sizeof(operands));
+  // These are exactly the original Interpret<false> calls. In particular, retain
+  // the cached handler, stale PC/NPC semantics and unchecked exception behavior.
+  for (u32 i = 0; i < operands.count; ++i)
+    DispatchBrowserInstruction(*operands.interpreter, UGeckoInstruction{ops[i].instruction},
+                               ops[i].handler);
+  return sizeof(AnyCallback) + BrowserInterpret::PayloadSize(operands.count);
+}
+
+bool CachedInterpreter::AppendBrowserInterpretOp(Interpreter& interpreter, UGeckoInstruction inst,
+                                                u32 pc)
+{
+  const u32 primary = inst.OPCD;
+  if (primary != 10 && primary != 11 && (primary < 32 || primary > 45))
+    return false;
+  FlushBrowserIntegerOps();
+  auto& batch = m_browser_interpret_batch;
+  if (batch.header.count == batch.ops.size() ||
+      (batch.header.count != 0 &&
+       (batch.header.interpreter != &interpreter ||
+        pc != batch.header.first_pc + 4 * batch.header.count)))
+    FlushBrowserInterpretOps();
+  if (batch.header.count == 0)
+    batch.header = {&interpreter, 0, pc};
+  batch.ops[batch.header.count++] = {Interpreter::GetInterpreterOp(inst), inst.hex};
+  return true;
+}
+
+void CachedInterpreter::FlushBrowserInterpretOps()
+{
+  auto& batch = m_browser_interpret_batch;
+  if (batch.header.count == 0)
+    return;
+  if (batch.header.count == 1)
+  {
+    const auto& op = batch.ops[0];
+    Write(Interpret<false>, {*batch.header.interpreter, op.handler, batch.header.first_pc,
+                             UGeckoInstruction{op.instruction}});
+  }
+  else
+  {
+    static_assert(alignof(BrowserInterpret::Batch) <= alignof(AnyCallback));
+    static_assert(sizeof(BrowserInterpret::Header) % alignof(AnyCallback) == 0);
+    static_assert(sizeof(BrowserInterpret::Op) % alignof(AnyCallback) == 0);
+    Write(AnyCallbackCast(RunBrowserInterpretOps), &batch,
+          BrowserInterpret::PayloadSize(batch.header.count));
+  }
+  batch.header.count = 0;
+}
