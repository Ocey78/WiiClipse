diff --git a/Source/Core/DolphinLibretro/SoftwareFrame.h b/Source/Core/DolphinLibretro/SoftwareFrame.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/DolphinLibretro/SoftwareFrame.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace Libretro::Video
+{
+struct SoftwareFrame
+{
+  unsigned width = 0;
+  unsigned height = 0;
+  std::vector<std::uint32_t> pixels;
+
+  // SWTexture stores RGBA bytes. Libretro XRGB8888 is the integer 0xXXRRGGBB,
+  // which is B,G,R,X in WebAssembly's little-endian memory.
+  bool CopyRGBA(const std::uint8_t* source, unsigned source_width, unsigned source_height,
+                int left, int top, int right, int bottom)
+  {
+    if (!source || !source_width || !source_height)
+      return false;
+    left = std::clamp(left, 0, static_cast<int>(source_width));
+    top = std::clamp(top, 0, static_cast<int>(source_height));
+    right = std::clamp(right, 0, static_cast<int>(source_width));
+    bottom = std::clamp(bottom, 0, static_cast<int>(source_height));
+    if (left >= right || top >= bottom)
+      return false;
+
+    width = static_cast<unsigned>(right - left);
+    height = static_cast<unsigned>(bottom - top);
+    pixels.resize(static_cast<std::size_t>(width) * height);
+    for (unsigned y = 0; y < height; ++y)
+    {
+      const auto* row = source +
+          (static_cast<std::size_t>(top + y) * source_width + left) * 4;
+      auto* output = pixels.data() + static_cast<std::size_t>(y) * width;
+      for (unsigned x = 0; x < width; ++x)
+      {
+        output[x] = 0xff000000u | (std::uint32_t{row[x * 4]} << 16) |
+                    (std::uint32_t{row[x * 4 + 1]} << 8) | row[x * 4 + 2];
+      }
+    }
+    return true;
+  }
+};
+}  // namespace Libretro::Video
