--- a/Externals/zlib-ng/zlib-ng/cmake/detect-arch.cmake
+++ b/Externals/zlib-ng/zlib-ng/cmake/detect-arch.cmake
@@ -88,6 +88,9 @@
 elseif("${ARCH}" MATCHES "riscv(32|64)")
     set(BASEARCH "riscv")
     set(BASEARCH_RISCV_FOUND TRUE)
+elseif("${ARCH}" MATCHES "^wasm(32|64)$")
+    # WebAssembly uses the portable C routines, not the unknown-CPU x86 fallback.
+    set(BASEARCH "wasm")
 else()
     set(BASEARCH "x86")
     set(BASEARCH_X86_FOUND TRUE)
