 #include "Core/PowerPC/PowerPC.h"
 #include "Core/System.h"
 
+#ifdef __EMSCRIPTEN__
+// Keep the existing handler semantics while allowing full LTO to inline hot
+// primary instructions instead of crossing a WebAssembly indirect-call barrier.
+// The cached callback remains authoritative, including injected/debug handlers.
+static void DispatchBrowserInstruction(Interpreter& interpreter, UGeckoInstruction inst,
+                                       Interpreter::Instruction handler)
+{
+  switch (inst.OPCD)
+  {
+  case 10:
+    if (handler == Interpreter::cmpli)
+    {
+      Interpreter::cmpli(interpreter, inst);
+      return;
+    }
+    break;
+  case 11:
+    if (handler == Interpreter::cmpi)
+    {
+      Interpreter::cmpi(interpreter, inst);
+      return;
+    }
+    break;
+  case 16:
+    if (handler == Interpreter::bcx)
+    {
+      Interpreter::bcx(interpreter, inst);
+      return;
+    }
+    break;
+  case 18:
+    if (handler == Interpreter::bx)
+    {
+      Interpreter::bx(interpreter, inst);
+      return;
+    }
+    break;
+  case 32:
+    if (handler == Interpreter::lwz)
+    {
+      Interpreter::lwz(interpreter, inst);
+      return;
+    }
+    break;
+  case 36:
+    if (handler == Interpreter::stw)
+    {
+      Interpreter::stw(interpreter, inst);
+      return;
+    }
+    break;
+  }
+  handler(interpreter, inst);
+}
+#endif
+
 CachedInterpreter::CachedInterpreter(Core::System& system) : JitBase(system), m_block_cache(*this)
 {
 }
