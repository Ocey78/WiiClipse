+#ifdef __EMSCRIPTEN__
+s32 CachedInterpreter::RunBrowserIntegerOps(PowerPC::PowerPCState& ppc_state,
+                                           const BrowserInteger::Header& operands)
+{
+  const auto* ops = reinterpret_cast<const BrowserInteger::Op*>(
+      reinterpret_cast<const u8*>(&operands) + sizeof(operands));
+  BrowserInteger::Execute(ppc_state.gpr, ops, operands.count);
+  return sizeof(AnyCallback) + BrowserInteger::PayloadSize(operands.count);
+}
+
+bool CachedInterpreter::AppendBrowserIntegerOp(u32 word, u32 pc)
+{
+  BrowserInteger::Op op;
+  if (!BrowserInteger::Decode(word, op))
+    return false;
+  auto& batch = m_browser_integer_batch;
+  // A skipped/reordered analyzer op must not make the disassembler invent a PC.
+  if (batch.header.count == batch.ops.size() ||
+      (batch.header.count != 0 && pc != batch.header.first_pc + 4 * batch.header.count))
+    FlushBrowserIntegerOps();
+  if (batch.header.count == 0)
+    batch.header.first_pc = pc;
+  batch.ops[batch.header.count++] = op;
+  return true;
+}
+
+void CachedInterpreter::FlushBrowserIntegerOps()
+{
+  auto& batch = m_browser_integer_batch;
+  if (batch.header.count == 0)
+    return;
+  static_assert(alignof(BrowserInteger::Batch) <= alignof(AnyCallback));
+  static_assert(sizeof(BrowserInteger::Header) % alignof(AnyCallback) == 0);
+  static_assert(sizeof(BrowserInteger::Op) % alignof(AnyCallback) == 0);
+  Write(AnyCallbackCast(RunBrowserIntegerOps), &batch,
+        BrowserInteger::PayloadSize(batch.header.count));
+  batch.header.count = 0;
+}
+#endif
