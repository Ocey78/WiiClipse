diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/BrowserIntegerOps.h b/Source/Core/Core/PowerPC/CachedInterpreter/BrowserIntegerOps.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/BrowserIntegerOps.h
@@ -0,0 +1,181 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <bit>
+#include <cstddef>
+
+#include "Common/CommonTypes.h"
+
+// Browser-only decoded integer runs. Only instructions whose entire effect is
+// one GPR write belong here. Rc/OE/carry, memory, traps, branches and FPU work
+// retain the normal interpreter path and its exception/debugger boundaries.
+namespace BrowserInteger
+{
+enum class Kind : u8
+{
+  LoadImmediate, AddImmediate, MultiplyImmediate, OrImmediate, XorImmediate,
+  RotateMask, RotateInsert, RotateRegisterMask,
+  Add, Subtract, Multiply, Negate,
+  And, AndComplement, Or, OrComplement, Xor, Nand, Nor, Equivalent,
+  ShiftLeft, ShiftRight, CountLeadingZeros, ExtendByte, ExtendHalf,
+};
+
+struct Op
+{
+  u32 value;
+  Kind kind;
+  u8 dst;
+  u8 a;
+  u8 b;
+};
+static_assert(sizeof(Op) == 8);
+
+struct Header
+{
+  u32 count = 0;
+  u32 first_pc = 0;
+};
+
+struct Batch
+{
+  Header header;
+  std::array<Op, 32> ops;
+};
+static_assert(offsetof(Batch, ops) == sizeof(Header));
+
+constexpr std::size_t PayloadSize(u32 count)
+{
+  return sizeof(Header) + count * sizeof(Op);
+}
+
+inline bool Decode(u32 word, Op& op)
+{
+  const u8 rd = (word >> 21) & 31;
+  const u8 ra = (word >> 16) & 31;
+  const u8 rb = (word >> 11) & 31;
+  const u32 primary = word >> 26;
+  const u32 immediate = word & 0xffff;
+  const u32 signed_immediate = immediate | ((immediate & 0x8000) ? 0xffff0000 : 0);
+  op = {0, Kind::LoadImmediate, rd, ra, rb};
+  switch (primary)
+  {
+  case 7:
+    op.kind = Kind::MultiplyImmediate;
+    op.value = signed_immediate;
+    return true;
+  case 14:
+  case 15:
+    op.kind = ra == 0 ? Kind::LoadImmediate : Kind::AddImmediate;
+    op.value = primary == 15 ? immediate << 16 : signed_immediate;
+    return true;
+  case 24:
+  case 25:
+  case 26:
+  case 27:
+    op.kind = primary < 26 ? Kind::OrImmediate : Kind::XorImmediate;
+    op.dst = ra;
+    op.a = rd;
+    op.value = (primary & 1) ? immediate << 16 : immediate;
+    return true;
+  case 20:
+  case 21:
+  case 23:
+  {
+    if (word & 1)  // Rc updates CR0.
+      return false;
+    const u32 mb = (word >> 6) & 31;
+    const u32 me = (word >> 1) & 31;
+    const u32 mask = (0xffffffffu >> mb) ^ (0x7fffffffu >> me);
+    op.kind = primary == 20 ? Kind::RotateInsert :
+              primary == 21 ? Kind::RotateMask : Kind::RotateRegisterMask;
+    op.dst = ra;
+    op.a = rd;
+    op.value = mb > me ? ~mask : mask;
+    return true;
+  }
+  case 31:
+    break;
+  default:
+    return false;
+  }
+
+  if (word & 1)
+    return false;
+  // Use the entire ten-bit subopcode: accepting just nine bits would silently
+  // accept OE forms and confuse other opcodes (e.g. srw's bit 10 is not OE).
+  const u32 subop = (word >> 1) & 1023;
+  switch (subop)
+  {
+  case 266: op.kind = Kind::Add; return true;
+  case 40: op.kind = Kind::Subtract; return true;
+  case 235: op.kind = Kind::Multiply; return true;
+  case 104: op.kind = Kind::Negate; return true;
+  default: break;
+  }
+  op.dst = ra;
+  op.a = rd;
+  switch (subop)
+  {
+  case 28: op.kind = Kind::And; return true;
+  case 60: op.kind = Kind::AndComplement; return true;
+  case 444: op.kind = Kind::Or; return true;
+  case 412: op.kind = Kind::OrComplement; return true;
+  case 316: op.kind = Kind::Xor; return true;
+  case 476: op.kind = Kind::Nand; return true;
+  case 124: op.kind = Kind::Nor; return true;
+  case 284: op.kind = Kind::Equivalent; return true;
+  case 24: op.kind = Kind::ShiftLeft; return true;
+  case 536: op.kind = Kind::ShiftRight; return true;
+  case 26: op.kind = Kind::CountLeadingZeros; return true;
+  case 954: op.kind = Kind::ExtendByte; return true;
+  case 922: op.kind = Kind::ExtendHalf; return true;
+  default: return false;
+  }
+}
+
+inline void Execute(u32* gpr, const Op* ops, std::size_t count)
+{
+  for (std::size_t i = 0; i < count; ++i)
+  {
+    const auto& op = ops[i];
+    // All inputs must be read before writing: destination and sources may alias.
+    const u32 a = gpr[op.a];
+    const u32 b = gpr[op.b];
+    u32 result;
+    switch (op.kind)
+    {
+    case Kind::LoadImmediate: result = op.value; break;
+    case Kind::AddImmediate: result = a + op.value; break;
+    case Kind::MultiplyImmediate: result = a * op.value; break;
+    case Kind::OrImmediate: result = a | op.value; break;
+    case Kind::XorImmediate: result = a ^ op.value; break;
+    case Kind::RotateMask: result = std::rotl(a, op.b) & op.value; break;
+    case Kind::RotateInsert:
+      result = (gpr[op.dst] & ~op.value) | (std::rotl(a, op.b) & op.value);
+      break;
+    case Kind::RotateRegisterMask: result = std::rotl(a, b & 31) & op.value; break;
+    case Kind::Add: result = a + b; break;
+    case Kind::Subtract: result = b - a; break;
+    case Kind::Multiply: result = a * b; break;
+    case Kind::Negate: result = 0u - a; break;
+    case Kind::And: result = a & b; break;
+    case Kind::AndComplement: result = a & ~b; break;
+    case Kind::Or: result = a | b; break;
+    case Kind::OrComplement: result = a | ~b; break;
+    case Kind::Xor: result = a ^ b; break;
+    case Kind::Nand: result = ~(a & b); break;
+    case Kind::Nor: result = ~(a | b); break;
+    case Kind::Equivalent: result = ~(a ^ b); break;
+    case Kind::ShiftLeft: result = (b & 32) ? 0 : a << (b & 31); break;
+    case Kind::ShiftRight: result = (b & 32) ? 0 : a >> (b & 31); break;
+    case Kind::CountLeadingZeros: result = std::countl_zero(a); break;
+    case Kind::ExtendByte: result = (a & 0xff) | ((a & 0x80) ? 0xffffff00 : 0); break;
+    case Kind::ExtendHalf: result = (a & 0xffff) | ((a & 0x8000) ? 0xffff0000 : 0); break;
+    }
+    gpr[op.dst] = result;
+  }
+}
+}  // namespace BrowserInteger
