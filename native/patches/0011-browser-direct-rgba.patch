+++ b/Source/Core/DolphinLibretro/BrowserFrame.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+// This browser-only hook leaves libretro's XRGB8888 callback contract intact.
+extern "C" void dolphin_browser_present_rgba(const void* data, unsigned width,
+                                             unsigned height, std::size_t pitch);
+
+namespace Libretro::Video
+{
+struct BrowserFrame
+{
+  const std::uint8_t* data = nullptr;
+  unsigned width = 0;
+  unsigned height = 0;
+  std::size_t pitch = 0;
+
+  // A bounded view into the source texture; copying into the transferable browser
+  // buffer happens once in the host, without a temporary color-swizzled image.
+  static BrowserFrame Crop(const std::uint8_t* source, unsigned source_width,
+                           unsigned source_height, int left, int top, int right, int bottom)
+  {
+    if (!source || !source_width || !source_height)
+      return {};
+    left = std::clamp(left, 0, static_cast<int>(source_width));
+    top = std::clamp(top, 0, static_cast<int>(source_height));
+    right = std::clamp(right, 0, static_cast<int>(source_width));
+    bottom = std::clamp(bottom, 0, static_cast<int>(source_height));
+    if (left >= right || top >= bottom)
+      return {};
+    return {source + (static_cast<std::size_t>(top) * source_width + left) * 4,
+            static_cast<unsigned>(right - left), static_cast<unsigned>(bottom - top),
+            static_cast<std::size_t>(source_width) * 4};
+  }
+};
+}  // namespace Libretro::Video
