 template <std::unsigned_integral T>
 void MMU::Write(const Common::MakeAtLeastU32<T> var, const u32 address)
 {
+#ifdef __EMSCRIPTEN__
+  if (m_power_pc.GetMemChecks().HasAny())
+#endif
