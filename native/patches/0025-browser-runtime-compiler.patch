+// UGeckoInstruction is a C++ aggregate passed indirectly in the wasm32 ABI.
+// Keep that private by-value copy in C++, not in the retained callback payload.
+extern "C" EMSCRIPTEN_KEEPALIVE void dweb_browser_compiler_instruction(u32 address, u32 word,
+                                                                       u32 handler)
+{
+  auto& interpreter = *reinterpret_cast<Interpreter*>(uintptr_t(address));
+  const UGeckoInstruction instruction{word};
+  reinterpret_cast<Interpreter::Instruction>(uintptr_t(handler))(interpreter, instruction);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int dweb_browser_compiler_install(u32 address, u32 id, u32 epoch,
+                                                                 u32 slot)
+{
+  if (!s_browser_compiler_owner || !s_browser_compiler_owner->BrowserCompilerOnOwnerThread())
+    return 0;
+  auto& registry = s_browser_compiler_owner->BrowserCompilerRegistry();
+  return registry.Install(reinterpret_cast<BrowserCompiler::Gate*>(uintptr_t(address)), id, epoch,
+                          reinterpret_cast<BrowserCompiler::Callback>(uintptr_t(slot)));
+}
+extern "C" EMSCRIPTEN_KEEPALIVE void dweb_browser_compiler_failed(u32 address, u32 id, u32 epoch)
+{
+  if (s_browser_compiler_owner && s_browser_compiler_owner->BrowserCompilerOnOwnerThread())
+    s_browser_compiler_owner->BrowserCompilerRegistry().Failed(
+        reinterpret_cast<BrowserCompiler::Gate*>(uintptr_t(address)), id, epoch);
+}
+extern "C" EMSCRIPTEN_KEEPALIVE int dweb_browser_compiler_evict(u32 address, u32 id, u32 epoch,
+                                                               u32 slot)
+{
+  if (!s_browser_compiler_owner || !s_browser_compiler_owner->BrowserCompilerOnOwnerThread())
+    return 0;
+  auto& registry = s_browser_compiler_owner->BrowserCompilerRegistry();
+  const bool result = registry.Evict(reinterpret_cast<BrowserCompiler::Gate*>(uintptr_t(address)),
+                                     id, epoch,
+                                     reinterpret_cast<BrowserCompiler::Callback>(uintptr_t(slot)));
+  s_browser_compiler_owner->DrainBrowserCompiler();
+  return result;
+}
+extern "C" EMSCRIPTEN_KEEPALIVE void dweb_set_browser_compiler(int enabled)
+{
+  if (!s_browser_compiler_owner || !s_browser_compiler_owner->BrowserCompilerOnOwnerThread())
+    return;
+  auto& registry = s_browser_compiler_owner->BrowserCompilerRegistry();
+  registry.enabled = enabled != 0;
+  if (!enabled)
+    registry.Reset();
+  s_browser_compiler_owner->DrainBrowserCompiler();
+}
+extern "C" EMSCRIPTEN_KEEPALIVE const char* dweb_browser_compiler_stats()
+{
+  static std::string json;
+  if (!s_browser_compiler_owner)
+  {
+    json = "{\"enabled\":false,\"compiled\":0,\"compiledCalls\":0,\"nativeFallbackCalls\":0}";
+    return json.c_str();
+  }
+  const auto& r = s_browser_compiler_owner->BrowserCompilerRegistry();
+  std::ostringstream out;
+  out << "{\"enabled\":" << (r.enabled ? "true" : "false") << ",\"epoch\":" << r.epoch
+      << ",\"gates\":" << r.live.size() << ",\"pending\":" << r.queued
+      << ",\"compiled\":" << r.compiled << ",\"compiledCalls\":" << r.compiled_calls
+      << ",\"nativeFallbackCalls\":" << r.fallback_calls << ",\"requests\":" << r.requests
+      << ",\"rejectedFallbackCalls\":" << r.rejected_calls
+      << ",\"rejected\":" << r.rejections << ",\"errors\":" << r.rejections
+      << ",\"promoted\":" << r.promotions << ",\"evictions\":" << r.evictions
+      << ",\"recompiles\":" << r.recompiles
+      << ",\"staleInstalls\":" << r.stale_installs << '}';
+  json = out.str();
+  return json.c_str();
+}
+
+bool CachedInterpreter::BrowserCompilerOnOwnerThread() const
+{
+  return m_browser_compiler_main_runtime && m_browser_compiler_thread == std::this_thread::get_id() &&
+         !m_system.IsDualCoreMode();
+}
+void CachedInterpreter::DrainBrowserCompiler()
+{
+  m_browser_compiler.Drain(dweb_browser_compile_release, dweb_browser_compile_clear);
+}
+void CachedInterpreter::RetireBrowserCompilerBlock(const JitBlock& block)
+{
+  if (block.near_end - block.normalEntry <
+      static_cast<ptrdiff_t>(sizeof(AnyCallback) + sizeof(BrowserCompilerGate)))
+    return;
+  if (*reinterpret_cast<const AnyCallback*>(block.normalEntry) !=
+      AnyCallbackCast(RunBrowserCompilerGate))
+    return;
+  auto& gate = *reinterpret_cast<BrowserCompilerGate*>(block.normalEntry + sizeof(AnyCallback));
+  m_browser_compiler.Retire(gate);
+  DrainBrowserCompiler();
+}
+
+s32 CachedInterpreter::RunBrowserCompilerGate(PowerPC::PowerPCState& ppc_state,
+                                             const BrowserCompilerGate& operands)
+{
+  auto& gate = const_cast<BrowserCompilerGate&>(operands);
+  auto& cached = *static_cast<CachedInterpreter*>(gate.owner);
+  auto& registry = cached.m_browser_compiler;
+  ++registry.active;
+  const bool allowed = registry.enabled && cached.BrowserCompilerOnOwnerThread() &&
+                       !cached.IsDebuggingEnabled() && !cached.IsProfilingEnabled() &&
+                       !cached.m_system.GetCPU().IsStepping();
+  if (allowed && gate.compiled)
+  {
+    ++registry.compiled_calls;
+    gate.compiled(ppc_state, gate.retained);
+  }
+  else
+  {
+    ++registry.fallback_calls;
+    if (gate.job == BrowserCompiler::Job::Rejected)
+      ++registry.rejected_calls;
+    if (allowed && registry.queued < 16 && gate.job == BrowserCompiler::Job::Idle &&
+        ++gate.hits >= (registry.compiled >= 512 && gate.retry_threshold < 2048 ?
+                           2048u : gate.retry_threshold))
+    {
+      gate.hits = 0;
+      const auto descriptor = registry.Retain(gate) ? cached.DescribeBrowserCompilerBlock(gate) :
+                                                    std::string{};
+      if (descriptor.empty())
+      {
+        gate.job = BrowserCompiler::Job::Rejected;
+        ++registry.rejections;
+        registry.DropCopy(gate);
+      }
+      else
+      {
+        ++registry.requests;
+        const int result = dweb_browser_compile_request(
+            descriptor.c_str(), static_cast<u32>(reinterpret_cast<uintptr_t>(&gate)), gate.id,
+            gate.epoch);
+        if (result > 0)
+        {
+          gate.job = BrowserCompiler::Job::Queued;
+          ++registry.queued;
+        }
+        else if (result < 0)
+        {
+          gate.job = BrowserCompiler::Job::Rejected;
+          ++registry.rejections;
+          registry.DropCopy(gate);
+        }
+        else
+        {
+          gate.retry_threshold = 4096;
+          registry.DropCopy(gate);
+        }
+      }
+    }
+    cached.ExecuteCallbackStream(gate.entry);
+  }
+  --registry.active;
+  cached.DrainBrowserCompiler();
+  return 0;
+}
+std::string CachedInterpreter::DescribeBrowserCompilerBlock(const BrowserCompilerGate& gate) const
+{
+  if (!gate.retained || !gate.entry || gate.end <= gate.entry)
+    return {};
+  const u8* cursor = gate.retained;
+  const u8* end = cursor + (gate.end - gate.entry);
+  const auto number = [](auto pointer) {
+    return static_cast<u32>(reinterpret_cast<uintptr_t>(pointer));
+  };
+  std::ostringstream out;
+  out << "{\"version\":1,\"gate\":" << number(&gate) << ",\"blockID\":" << gate.id
+      << ",\"epoch\":" << gate.epoch << ",\"entry\":" << number(cursor)
+      << ",\"instructionBridge\":" << number(dweb_browser_compiler_instruction)
+      << ",\"end\":" << number(end) << ",\"state\":{\"gpr\":"
+      << offsetof(PowerPC::PowerPCState, gpr) << ",\"pc\":" << offsetof(PowerPC::PowerPCState, pc)
+      << ",\"npc\":" << offsetof(PowerPC::PowerPCState, npc) << "},\"ops\":[";
+  unsigned records = 0;
+  bool terminal = false;
+  const auto comma = [&] { if (records++) out << ','; };
+  const auto allowed_instruction = [](u32 word) {
+    const u32 sub = (word >> 1) & 1023;
+    return (word >> 26) != 31 || (sub != 54 && sub != 86 && sub != 470 && sub != 982 && sub != 1014);
+  };
+  const auto instruction = [&](Interpreter::Instruction handler, Interpreter* interpreter,
+                               u32 word, bool write_pc, u32 pc) {
+    if (!handler || !interpreter || !allowed_instruction(word))
+      return false;
+    comma();
+    out << "{\"kind\":\"instruction\",\"handler\":" << number(handler)
+        << ",\"interpreter\":" << number(interpreter) << ",\"word\":" << word << ",\"pc\":";
+    if (write_pc) out << pc; else out << "null";
+    out << '}';
+    return true;
+  };
+  while (cursor < end && records < 2048)
+  {
+    if (end - cursor < static_cast<ptrdiff_t>(sizeof(AnyCallback)))
+      return {};
+    const auto callback = *reinterpret_cast<const AnyCallback*>(cursor);
+    const u8* payload = cursor + sizeof(callback);
+    std::size_t size = 0;
+    if (callback == AnyCallbackCast(RunBrowserIntegerOps))
+    {
+      if (end - payload < static_cast<ptrdiff_t>(sizeof(BrowserInteger::Header)))
+        return {};
+      const auto& header = *reinterpret_cast<const BrowserInteger::Header*>(payload);
+      if (!header.count || header.count > 32)
+        return {};
+      size = BrowserInteger::PayloadSize(header.count);
+      if (end - payload < static_cast<ptrdiff_t>(size))
+        return {};
+      const auto* ops = reinterpret_cast<const BrowserInteger::Op*>(payload + sizeof(header));
+      comma();
+      out << "{\"kind\":\"integer\",\"ops\":[";
+      for (u32 i = 0; i < header.count; ++i)
+      {
+        const auto& op = ops[i];
+        if (static_cast<unsigned>(op.kind) > 24 || op.dst > 31 || op.a > 31 || op.b > 31)
+          return {};
+        if (i) out << ',';
+        out << "{\"kind\":" << static_cast<unsigned>(op.kind) << ",\"value\":" << op.value
+            << ",\"dst\":" << unsigned(op.dst) << ",\"a\":" << unsigned(op.a)
+            << ",\"b\":" << unsigned(op.b) << '}';
+      }
+      out << "]}";
+    }
+    else if (callback == AnyCallbackCast(RunBrowserInterpretOps))
+    {
+      if (end - payload < static_cast<ptrdiff_t>(sizeof(BrowserInterpret::Header)))
+        return {};
+      const auto& header = *reinterpret_cast<const BrowserInterpret::Header*>(payload);
+      if (!header.count || header.count > 32)
+        return {};
+      size = BrowserInterpret::PayloadSize(header.count);
+      if (end - payload < static_cast<ptrdiff_t>(size))
+        return {};
+      const auto* ops = reinterpret_cast<const BrowserInterpret::Op*>(payload + sizeof(header));
+      for (u32 i = 0; i < header.count; ++i)
+        if (!instruction(ops[i].handler, header.interpreter, ops[i].instruction, false, 0))
+          return {};
+    }
+    else if (callback == AnyCallbackCast(Interpret<false>) ||
+             callback == AnyCallbackCast(Interpret<true>))
+    {
+      size = sizeof(InterpretOperands);
+      if (end - payload < static_cast<ptrdiff_t>(size))
+        return {};
+      const auto& op = *reinterpret_cast<const InterpretOperands*>(payload);
+      if (!instruction(op.func, &op.interpreter, op.inst.hex,
+                       callback == AnyCallbackCast(Interpret<true>), op.current_pc))
+        return {};
+    }
+    else if (callback == AnyCallbackCast(InterpretAndCheckExceptions<false>) ||
+             callback == AnyCallbackCast(InterpretAndCheckExceptions<true>) ||
+             callback == AnyCallbackCast(EndBlock<false>))
+    {
+      terminal = callback == AnyCallbackCast(EndBlock<false>);
+      size = terminal ? sizeof(EndBlockOperands<false>) :
+                        sizeof(InterpretAndCheckExceptionsOperands);
+      if (end - payload < static_cast<ptrdiff_t>(size))
+        return {};
+      if (!terminal && !allowed_instruction(
+                           reinterpret_cast<const InterpretAndCheckExceptionsOperands*>(payload)->inst.hex))
+        return {};
+      comma();
+      out << "{\"kind\":\"callback\",\"role\":\"" << (terminal ? "end" : "checked")
+          << "\",\"handler\":" << number(callback) << ",\"payload\":" << number(payload)
+          << ",\"distance\":" << sizeof(callback) + size << ",\"terminal\":"
+          << (terminal ? "true" : "false") << '}';
+    }
+    else
+    {
+      // HLE, debugger, FPU checks, broken/idle/cache loops and unknown callbacks
+      // remain on the exact original stream, including all state observers.
+      return {};
+    }
+    cursor = payload + size;
+    if (terminal)
+      break;
+  }
+  if (!terminal || cursor != end || records > 2048)
+    return {};
+  out << "]}";
+  return out.str();
+}
+
+s32 CachedInterpreter::RunBrowserCompilerGate(std::ostream& stream,
