+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+#include "Common/CommonTypes.h"
+
+namespace PowerPC { struct PowerPCState; }
+namespace BrowserCompiler
+{
+using Callback = s32 (*)(PowerPC::PowerPCState&, const void*);
+enum class Job : u32 { Idle, Queued, Rejected };
+// Stored before the immutable original callback stream. Never owns guest memory.
+struct Gate
+{
+  void* owner = nullptr;
+  const u8* entry = nullptr;
+  const u8* end = nullptr;
+  const u8* retained = nullptr;
+  u32 id = 0, epoch = 0, hits = 0, retry_threshold = 128, ever_promoted = 0;
+  Job job = Job::Idle;
+  Callback compiled = nullptr;
+};
+
+class Registry
+{
+public:
+  bool enabled = true;
+  u32 epoch = NextEpoch(), next_id = 0;
+  unsigned active = 0, queued = 0, compiled = 0;
+  u64 compiled_calls = 0, fallback_calls = 0, requests = 0, rejections = 0, stale_installs = 0;
+  u64 promotions = 0, evictions = 0, recompiles = 0;
+  u64 rejected_calls = 0;
+  std::unordered_set<Gate*> live;
+
+  void Add(Gate& gate)
+  {
+    gate.id = ++next_id;
+    gate.epoch = epoch;
+    gate.hits = 0;
+    gate.retry_threshold = 128;
+    gate.ever_promoted = 0;
+    gate.job = Job::Idle;
+    gate.compiled = nullptr;
+    live.insert(&gate);
+  }
+  Gate* Find(Gate* gate, u32 id, u32 expected_epoch)
+  {
+    if (expected_epoch != epoch || !live.contains(gate))
+      return nullptr;
+    return gate->id == id && gate->epoch == epoch ? gate : nullptr;
+  }
+  bool Install(Gate* gate, u32 id, u32 expected_epoch, Callback callback)
+  {
+    gate = Find(gate, id, expected_epoch);
+    if (!enabled || active || !gate || !callback || gate->job != Job::Queued || gate->compiled)
+    {
+      ++stale_installs;
+      return false;
+    }
+    gate->compiled = callback;
+    gate->job = Job::Idle;
+    --queued;
+    ++compiled;
+    ++promotions;
+    if (gate->ever_promoted++)
+      ++recompiles;
+    return true;
+  }
+  void Failed(Gate* gate, u32 id, u32 expected_epoch)
+  {
+    if (auto* found = Find(gate, id, expected_epoch); found && found->job == Job::Queued)
+    {
+      found->job = Job::Rejected;
+      --queued;
+      ++rejections;
+      DropCopy(*found);
+    }
+  }
+  void Retire(Gate& gate)
+  {
+    if (!live.erase(&gate))
+      return;
+    if (gate.compiled)
+    {
+      retired.push_back(static_cast<u32>(reinterpret_cast<uintptr_t>(gate.compiled)));
+      gate.compiled = nullptr;
+      --compiled;
+    }
+    if (gate.job == Job::Queued)
+      --queued;
+    gate.job = Job::Rejected;
+    DropCopy(gate);
+  }
+  bool Evict(Gate* gate, u32 id, u32 expected_epoch, Callback callback)
+  {
+    gate = Find(gate, id, expected_epoch);
+    if (active || !gate || !gate->compiled || gate->compiled != callback)
+      return false;
+    gate->compiled = nullptr;
+    gate->job = Job::Idle;
+    gate->hits = 0;
+    gate->retry_threshold = 4096;
+    --compiled;
+    ++evictions;
+    DropCopy(*gate);
+    return true; // JS releases only after this acknowledgement.
+  }
+  bool Retain(Gate& gate)
+  {
+    if (gate.retained)
+      return true;
+    const auto length = static_cast<std::size_t>(gate.end - gate.entry);
+    if (!length || length > 65536 || copy_bytes + length > 528 * 65536)
+      return false;
+    Copy copy{std::make_unique<u8[]>(length), length};
+    std::memcpy(copy.bytes.get(), gate.entry, length);
+    gate.retained = copy.bytes.get();
+    copy_bytes += length;
+    copies.emplace(&gate, std::move(copy));
+    return true;
+  }
+  void DropCopy(Gate& gate)
+  {
+    gate.retained = nullptr;
+    if (auto found = copies.find(&gate); found != copies.end())
+    {
+      old_copies.push_back(std::move(found->second));
+      copies.erase(found);
+    }
+  }
+  // Invalidate every async identity before any code address can be reused.
+  // Live blocks are retained for a same-core disable/enable A/B comparison.
+  void Reset()
+  {
+    epoch = NextEpoch();
+    for (auto* gate : live)
+    {
+      gate->epoch = epoch;
+      gate->hits = 0;
+      gate->retry_threshold = 128;
+      gate->job = Job::Idle;
+      gate->compiled = nullptr;
+      DropCopy(*gate);
+    }
+    compiled = queued = 0;
+    pending_clear = true;
+    retired.clear();
+  }
+  template <typename Release, typename Clear>
+  void Drain(Release release, Clear clear)
+  {
+    if (active || (!pending_clear && retired.empty() && old_copies.empty()))
+      return;
+    if (pending_clear)
+    {
+      pending_clear = false;
+      clear(epoch);
+      retired.clear();
+    }
+    else
+    {
+      for (u32 slot : retired)
+        release(slot);
+      retired.clear();
+    }
+    for (const auto& copy : old_copies)
+      copy_bytes -= copy.length;
+    old_copies.clear();
+  }
+private:
+  bool pending_clear = false;
+  std::vector<u32> retired;
+  struct Copy { std::unique_ptr<u8[]> bytes; std::size_t length; };
+  std::unordered_map<Gate*, Copy> copies; // Promotion/retirement only, never the execution path.
+  std::vector<Copy> old_copies;
+  std::size_t copy_bytes = 0;
+  inline static u32 global_epoch = 0;
+  static u32 NextEpoch() { if (++global_epoch == 0) ++global_epoch; return global_epoch; }
+};
+}
