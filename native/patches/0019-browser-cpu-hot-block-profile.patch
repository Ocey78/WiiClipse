diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/BrowserCPUProfile.h b/Source/Core/Core/PowerPC/CachedInterpreter/BrowserCPUProfile.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/BrowserCPUProfile.h
@@ -0,0 +1,119 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <sstream>
+#include <string>
+
+// Included only by diagnostic Emscripten builds. Samples never inspect guest
+// memory or alter dispatch, and the fixed table cannot grow with title activity.
+namespace BrowserCPU
+{
+class Profile
+{
+public:
+  static constexpr std::size_t kCapacity = 4096;
+  static constexpr std::uint64_t kStride = 64;
+  static constexpr std::size_t kProbeLimit = 16;
+
+  void SetEnabled(bool enabled) { m_enabled = enabled; }
+  void Reset()
+  {
+    m_entries.fill({});
+    m_seen = m_sampled = m_dropped = 0;
+  }
+
+  void Record(std::uint32_t pc, std::uint32_t flags)
+  {
+    if (!m_enabled || (++m_seen % kStride) != 0)
+      return;
+    ++m_sampled;
+    const std::uint32_t hash = ((pc >> 2) ^ (pc >> 16)) * 0x9e3779b1u ^ flags * 0x85ebca6bu;
+    for (std::size_t probe = 0; probe < kProbeLimit; ++probe)
+    {
+      auto& entry = m_entries[(hash + probe) & (kCapacity - 1)];
+      if (entry.count == 0)
+      {
+        entry = {pc, flags, 1};
+        return;
+      }
+      if (entry.pc == pc && entry.flags == flags)
+      {
+        ++entry.count;
+        return;
+      }
+    }
+    ++m_dropped;
+  }
+
+  template <typename Reader>
+  std::string Snapshot(std::uint32_t read_flags, Reader&& read_instruction) const
+  {
+    std::array<const Entry*, kCapacity> ranked{};
+    std::size_t count = 0;
+    for (const auto& entry : m_entries)
+      if (entry.count != 0)
+        ranked[count++] = &entry;
+    const std::size_t top = std::min(count, std::size_t{32});
+    std::partial_sort(ranked.begin(), ranked.begin() + top, ranked.begin() + count,
+                      [](const Entry* a, const Entry* b) {
+                        if (a->count != b->count)
+                          return a->count > b->count;
+                        if (a->pc != b->pc)
+                          return a->pc < b->pc;
+                        return a->flags < b->flags;
+                      });
+    std::ostringstream json;
+    json << "{\"enabled\":" << (m_enabled ? "true" : "false")
+         << ",\"seenBlocks\":" << m_seen << ",\"sampledBlocks\":" << m_sampled
+         << ",\"droppedSamples\":" << m_dropped << ",\"stride\":" << kStride
+         << ",\"capacity\":" << kCapacity << ",\"readFeatureFlags\":" << read_flags
+         << ",\"blocks\":[";
+    for (std::size_t i = 0; i < top; ++i)
+    {
+      const auto& entry = *ranked[i];
+      if (i != 0)
+        json << ',';
+      json << "{\"pc\":" << entry.pc << ",\"featureFlags\":" << entry.flags
+           << ",\"count\":" << entry.count << ",\"words\":[";
+      // The snapshot's translation state may differ from a recorded block.
+      // Never label words read under another state as that block's instructions.
+      if (entry.flags == read_flags)
+      {
+        for (std::uint32_t word = 0; word < 12; ++word)
+        {
+          const std::uint32_t address = entry.pc + word * 4;
+          if (address < entry.pc)
+            break;
+          const auto instruction = read_instruction(address);
+          if (!instruction)
+            break;
+          if (word != 0)
+            json << ',';
+          json << *instruction;
+        }
+      }
+      json << "]}";
+    }
+    json << "]}";
+    return json.str();
+  }
+
+private:
+  struct Entry
+  {
+    std::uint32_t pc = 0;
+    std::uint32_t flags = 0;
+    std::uint64_t count = 0;
+  };
+  std::array<Entry, kCapacity> m_entries{};
+  bool m_enabled = false;
+  std::uint64_t m_seen = 0;
+  std::uint64_t m_sampled = 0;
+  std::uint64_t m_dropped = 0;
+};
+}  // namespace BrowserCPU
